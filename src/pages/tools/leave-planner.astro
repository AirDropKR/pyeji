---
// 리그 스타트 연차 계산기. 계산은 브라우저에서 (src/lib/leave.ts, LeavePlanner.tsx), 공휴일은 src/data/holidays.json
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import LeavePlanner, { type PlannerSeason } from '../../components/LeavePlanner';
import { holidaySources, holidayCoverage } from '../../lib/leave';
import { kstIso, buildNow, formatKst } from '../../lib/time';
import { sortByStart } from '../../lib/seasons';

const games = await getCollection('games');
// 다가오는 시즌만 넘긴다 (브라우저에서 오늘 기준으로 한 번 더 거른다). 빌드 하루 전 것까지 넣어 재빌드 전 공백을 막는다
const seasons: PlannerSeason[] = sortByStart(await getCollection('seasons'))
  .filter((s) => Date.parse(s.data.startsAt) > buildNow() - 86_400_000)
  .map((s) => ({
    id: s.id,
    label: `${games.find((g) => g.id === s.data.gameId.id)!.data.shortName} ${s.data.name}`,
    start: kstIso(s.data.startsAt, 'day'),
    estimated: s.data.status === 'estimated',
  }));
---
<Base
  title="리그 스타트 연차 계산기"
  description="POE·POE2·디아블로 시즌 시작일에 연차를 며칠 쓰면 주말·공휴일과 이어 며칠 쉴 수 있는지 계산. 2026~2027년 공휴일·대체공휴일 반영, 한국 시간."
>
  <section class="hero">
    <div>
      <h1>리그 스타트 연차 계산기</h1>
      <p>시즌 시작일과 쓸 수 있는 연차 일수를 고르면, 시작일을 포함해 주말·공휴일과 이어 가장 길게 쉬는 날짜를 계산.</p>
    </div>
  </section>

  <section class="section tight">
    <LeavePlanner client:load seasons={seasons} />
  </section>

  <section class="section prose" aria-labelledby="how-title">
    <h2 class="section-title" id="how-title">계산 기준</h2>
    <ul>
      <li>시즌 시작일은 한국 날짜. 새벽에 열리는 시즌도 그 날짜를 쉬는 기간에 포함</li>
      <li>쉬는 날: 토요일, 일요일, 관공서 공휴일과 대체공휴일</li>
      <li>연속 기간이 같으면 연차를 덜 쓰는 쪽, 그다음 시즌 시작일 뒤로 더 오래 쉬는 쪽</li>
      <li>시작일이 아직 발표되지 않은 시즌은 목록에 없음. 시각이 미발표여도 날짜가 발표됐으면 포함</li>
      <li>회사마다 휴무일이 다를 수 있음 (창립기념일 같은 회사 휴무, 교대 근무 등은 반영하지 않음)</li>
    </ul>
    <h2 class="section-title">공휴일 출처</h2>
    <p class="small">{formatKst(`${holidayCoverage.from}T03:00:00Z`, 'day', true)} ~ {formatKst(`${holidayCoverage.to}T03:00:00Z`, 'day', true)}</p>
    <ul class="small">
      {holidaySources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a> <span class="muted">(확인 {s.checkedAt})</span></li>)}
    </ul>
  </section>
</Base>
