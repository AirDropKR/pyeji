---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { timelineFor } from '../lib/seasons';
import { formatKst, daysUntil, ddayLabel } from '../lib/time';

const now = Date.now();
const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const seasons = await getCollection('seasons');
const events = await getCollection('events');
const posts = (await getCollection('posts')).sort(
  (a, b) => Date.parse(b.data.publishedAt) - Date.parse(a.data.publishedAt),
);
const gameOf = (id: string) => games.find((g) => g.id === id)!;

const rows = games.map((g) => ({ g, ...timelineFor(g.id, seasons, now) }));
const hero = seasons
  .filter((s) => Date.parse(s.data.startsAt) > now)
  .sort((a, b) => Date.parse(a.data.startsAt) - Date.parse(b.data.startsAt))[0];
const heroGame = hero && gameOf(hero.data.gameId.id);
const upcoming = events
  .filter((e) => Date.parse(e.data.endsAt ?? e.data.startsAt) > now)
  .sort((a, b) => Date.parse(a.data.startsAt) - Date.parse(b.data.startsAt))
  .slice(0, 6);
---
<Base>
  {hero && heroGame ? (
    <section class="hero">
      <div>
        <p class="muted" style="margin:0 0 6px">가장 먼저 열리는 시즌</p>
        <h1>{heroGame.data.shortName} {hero.data.name}</h1>
        <p>
          한국 시간 {formatKst(hero.data.startsAt, hero.data.timePrecision)} 시작
          {hero.data.status === 'estimated' && ' (예상)'}
          {hero.data.timePrecision === 'day' && <span class="muted">, 정확한 시각은 아직 발표 전</span>}
        </p>
      </div>
      <span class:list={['stamp big', { estimate: hero.data.status === 'estimated' }]} data-dday={hero.data.startsAt}>
        {ddayLabel(daysUntil(hero.data.startsAt, now))}
      </span>
    </section>
  ) : (
    <section class="hero"><h1>지금 발표된 다음 시즌이 없어요</h1></section>
  )}

  <section style="margin-top:28px" aria-labelledby="games-title">
    <h2 class="section-title" id="games-title">게임별 시즌</h2>
    <ul class="games">
      {rows.map(({ g, current, next, currentEndsAt }) => (
        <li class="game-row gc" style={`--game-raw:${g.data.themeColor}`}>
          <div>
            <h3><a href={`/games/${g.id}`}>{g.data.shortName}</a></h3>
            <span class="small muted">{g.data.name}</span>
          </div>
          <div>
            {current ? (
              <>
                <strong>{current.data.name}</strong>
                {currentEndsAt && (
                  <div class="progress" data-progress-start={current.data.startsAt} data-progress-end={currentEndsAt} aria-hidden="true"><i style="width:0"></i></div>
                )}
                <span class="small muted" style="display:block">
                  <span data-elapsed={current.data.startsAt}></span>
                  {current.data.endsAt && `, ${formatKst(current.data.endsAt, 'exact')} 종료`}
                </span>
              </>
            ) : (
              <span class="muted">진행 중인 {g.data.seasonTerm} 정보가 아직 없어요</span>
            )}
          </div>
          <div class="next">
            {next ? (
              <>
                <span class:list={['stamp small', { estimate: next.data.status === 'estimated' }]} data-dday={next.data.startsAt}>
                  {ddayLabel(daysUntil(next.data.startsAt, now))}
                </span>
                <span class="when">
                  {next.data.name} {formatKst(next.data.startsAt, next.data.timePrecision)}
                  {next.data.status === 'estimated' && ' 예상'}
                </span>
              </>
            ) : (
              <span class="small muted">다음 {g.data.seasonTerm} 미발표</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <div class="split">
    <section aria-labelledby="events-title">
      <h2 class="section-title" id="events-title">다가오는 일정</h2>
      {upcoming.length ? (
        <ul class="plain-list">
          {upcoming.map((e) => {
            const g = gameOf(e.data.gameId.id);
            return (
              <li class="gc" style={`--game-raw:${g.data.themeColor}`}>
                <span class="date">{formatKst(e.data.startsAt, e.data.timePrecision)}</span>
                <span class="tag">{g.data.shortName}</span>{e.data.title}
              </li>
            );
          })}
        </ul>
      ) : <p class="muted">예정된 공개 방송이나 일정이 없어요.</p>}
    </section>
    <section aria-labelledby="posts-title">
      <h2 class="section-title" id="posts-title">최근 사전 정보</h2>
      {posts.length ? (
        <ul class="plain-list">
          {posts.slice(0, 5).map((p) => {
            const g = gameOf(p.data.gameId.id);
            return (
              <li class="gc" style={`--game-raw:${g.data.themeColor}`}>
                <span class="date">{formatKst(p.data.publishedAt, 'day')} 갱신</span>
                <span class="tag">{g.data.shortName}</span><a href={`/posts/${p.id}`}>{p.data.title}</a>
              </li>
            );
          })}
        </ul>
      ) : <p class="muted">아직 정리한 글이 없어요.</p>}
    </section>
  </div>
</Base>
