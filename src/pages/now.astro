---
// 지금: 모든 게임의 지금 상황을 한 화면에. 홈 화면 앱의 시작 화면
// 막 열린 시즌 → 다음 오픈 → 막차 → 게임별 한 줄. 모든 칸은 해당 시즌 페이지로
// 단계 판정은 빌드 때(매일 재빌드), D-day·n일째·카운트다운은 live.ts가 브라우저에서 다시 계산
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { timelineFor, seasonPath, stageOf, stageLabel, seasonEnd, seasonDay } from '../lib/seasons';
import { formatKst, buildNow, daysUntil, ddayLabel } from '../lib/time';
import { ogPath } from '../lib/og-paths';
import DdayStamp from '../components/DdayStamp.astro';
import GameStamp from '../components/GameStamp.astro';
import Mascot from '../components/Mascot.astro';

const now = buildNow();
const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const seasons = await getCollection('seasons');
const gameOf = (id: string) => games.find((g) => g.id === id)!;
const startMs = (s: { data: { startsAt: string } }) => Date.parse(s.data.startsAt);

// 1. 막 열린 시즌: 전부, 최근에 시작한 순
const fresh = seasons.filter((s) => stageOf(s, seasons, now) === 'fresh').sort((a, b) => startMs(b) - startMs(a));
// 2. 다음 오픈: 먼저 시작하는 순으로 2개
const upcoming = seasons.filter((s) => startMs(s) > now).sort((a, b) => startMs(a) - startMs(b));
const nextOpens = upcoming.slice(0, 2);
// 3. 막차: 종료가 확정된 것만 (종료일 명시, 또는 확정된 다음 시즌 시작)
const ending = seasons
  .filter((s) => stageOf(s, seasons, now) === 'ending')
  .map((s) => {
    const end = seasonEnd(s, seasons)!;
    const nextConfirmed = upcoming.find((u) => u.data.gameId.id === s.data.gameId.id && u.data.startsAt === end)?.data.status === 'confirmed';
    return { s, end, confirmed: Boolean(s.data.endsAt) || nextConfirmed };
  })
  .filter((e) => e.confirmed)
  .sort((a, b) => Date.parse(a.end) - Date.parse(b.end));
// 4. 게임별 한 줄
const rows = games.map((g) => {
  const t = timelineFor(g.id, seasons, now);
  return { g, ...t, stage: t.current ? stageOf(t.current, seasons, now) : undefined };
});
---
<Base
  title="지금 할 만한 핵앤슬래시 시즌 한눈에"
  description="POE1·POE2·디아블로 2·4·토치라이트·라스트 에폭의 막 열린 시즌, 다음 오픈 D-day, 곧 끝나는 시즌을 한 화면에. 한국 시간 기준."
  image={ogPath('page', 'now')}
>
  <header class="now-head">
    <h1>지금</h1>
    <p class="small muted flush">모든 게임의 지금 상황, 한국 시간</p>
  </header>

  <div class="now-grid" data-my-scope>
    <div class="now-col">
      <section class="now-sec" aria-labelledby="now-fresh">
        <h2 class="now-title" id="now-fresh">지금 줍기 좋은 폐지</h2>
        {fresh.length ? (
          <ul class="now-cards" data-my-list>
            {fresh.map((s) => {
              const g = gameOf(s.data.gameId.id);
              return (
                <li data-game={g.id}>
                  <a class="now-card gc" style={`--game-raw:${g.data.themeColor}`} href={seasonPath(s)}>
                    <GameStamp game={g} size="sm" />
                    <span class="now-card-body">
                      <span class="now-game">{g.data.shortName}</span>
                      <b class="now-season">{s.data.name}</b>
                      <span class="small muted">시작 <span data-elapsed={s.data.startsAt}>{seasonDay(s, now)}일째</span></span>
                    </span>
                    <DdayStamp at={s.data.startsAt} size="small" />
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          upcoming[0] ? (
            <a class="now-card now-empty" href={seasonPath(upcoming[0])}>
              <Mascot form="icon" size={36} />
              <span class="now-card-body">지금 막 열린 시즌 없음<span class="small muted">다음 오픈까지 <span data-dday={upcoming[0].data.startsAt}>{ddayLabel(daysUntil(upcoming[0].data.startsAt, now))}</span></span></span>
            </a>
          ) : <p class="muted small">지금 막 열린 시즌 없음</p>
        )}
      </section>

      <section class="now-sec" aria-labelledby="now-next">
        <h2 class="now-title" id="now-next">다음 오픈</h2>
        {nextOpens.length ? (
          <ul class="now-cards" data-my-list>
            {nextOpens.map((s) => {
              const g = gameOf(s.data.gameId.id);
              return (
                <li data-game={g.id}>
                  <a class="now-card gc" style={`--game-raw:${g.data.themeColor}`} href={seasonPath(s)}>
                    <GameStamp game={g} size="sm" />
                    <span class="now-card-body">
                      <span class="now-game">{g.data.shortName}</span>
                      <b class="now-season">{s.data.name}</b>
                      <span class="small">{formatKst(s.data.startsAt, s.data.timePrecision)} 오픈{s.data.status === 'estimated' && ' (예상)'}</span>
                      {s.data.timePrecision === 'day'
                        ? <span class="small muted">시각 미발표</span>
                        : <span class="small muted">남은 시간 <b class="now-cd" data-countdown={s.data.startsAt} data-precision="exact"></b></span>}
                    </span>
                    <DdayStamp at={s.data.startsAt} size="mid" estimated={s.data.status === 'estimated'} />
                  </a>
                </li>
              );
            })}
          </ul>
        ) : <p class="muted small">발표된 다음 시즌 없음</p>}
      </section>

      {ending.length > 0 && (
        <section class="now-sec" aria-labelledby="now-ending">
          <h2 class="now-title" id="now-ending">막차</h2>
          <ul class="now-cards" data-my-list>
            {ending.map(({ s, end }) => {
              const g = gameOf(s.data.gameId.id);
              return (
                <li data-game={g.id}>
                  <a class="now-card gc" style={`--game-raw:${g.data.themeColor}`} href={seasonPath(s)}>
                    <GameStamp game={g} size="sm" />
                    <span class="now-card-body">
                      <span class="now-game">{g.data.shortName}</span>
                      <b class="now-season">{s.data.name}</b>
                      <span class="small">{formatKst(end, 'exact')} 종료</span>
                    </span>
                    <DdayStamp at={end} size="small" />
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </div>

    <section class="now-sec" aria-labelledby="now-games">
      <h2 class="now-title" id="now-games">게임별</h2>
      <ul class="now-rows" data-my-list data-my-fold>
        {rows.map(({ g, current, next, stage }) => (
          <li data-game={g.id}>
            <a class="now-row gc" style={`--game-raw:${g.data.themeColor}`} href={current ? seasonPath(current) : next ? seasonPath(next) : `/games/${g.id}/`}>
              <GameStamp game={g} size="sm" />
              <span class="now-row-main">
                <b>{g.data.shortName}</b>
                {current ? (
                  <span class="small"><span class:list={['stage-chip', { ending: stage === 'ending', fresh: stage === 'fresh' }]}>{stageLabel[stage!]}</span>{current.data.name}</span>
                ) : (
                  <span class="small muted">{g.data.seasonTerm} 없음</span>
                )}
              </span>
              <span class="now-row-next small">
                {next ? (
                  <><span class="muted">다음</span> <DdayStamp at={next.data.startsAt} estimated={next.data.status === 'estimated'} /></>
                ) : (
                  <span class="muted">다음 미발표</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <p class="now-foot small muted">
    오늘 <span data-today>{formatKst(new Date(now).toISOString(), 'day')}</span> · 데이터 갱신 {formatKst(new Date(now).toISOString(), 'exact')}
  </p>
</Base>
