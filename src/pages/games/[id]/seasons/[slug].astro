---
import Base from '../../../../layouts/Base.astro';
import { postModified } from '../../../../lib/posts';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { seasonImage } from '../../../../lib/images';
import DdayStamp from '../../../../components/DdayStamp.astro';
import SeasonName from '../../../../components/SeasonName.astro';
import SeasonProgress from '../../../../components/SeasonProgress.astro';
import GameStamp from '../../../../components/GameStamp.astro';
import PostThumb from '../../../../components/PostThumb.astro';
import { sortByStart, seasonPath, isIndexable, seasonMilestones, phaseOf, stageOf, stageLabel, certaintyLabel } from '../../../../lib/seasons';
import MilestoneTimeline from '../../../../components/MilestoneTimeline.astro';
import Countdown from '../../../../components/Countdown.astro';
import SeasonImages from '../../../../components/SeasonImages.astro';
import YouTubeEmbed from '../../../../components/YouTubeEmbed.astro';
import { formatKst, kstDay, kstIso } from '../../../../lib/time';
import { josa } from '../../../../lib/korean';

export async function getStaticPaths() {
  const games = await getCollection('games');
  const seasons = await getCollection('seasons');
  const posts = await getCollection('posts');
  const events = await getCollection('events');
  return seasons.map((season) => {
    const game = games.find((g) => g.id === season.data.gameId.id)!;
    const list = sortByStart(seasons.filter((s) => s.data.gameId.id === game.id));
    const i = list.findIndex((s) => s.id === season.id);
    return {
      params: { id: game.id, slug: season.data.slug },
      props: {
        season,
        game,
        prev: list[i - 1],
        next: list[i + 1],
        phase: phaseOf(season, seasons),
        stage: stageOf(season, seasons),
        indexable: isIndexable(season, seasons, posts.filter((p) => p.data.seasonId?.id === season.id).length),
        posts: posts
          .filter((p) => p.data.seasonId?.id === season.id)
          .sort((a, b) => Date.parse(postModified(b)) - Date.parse(postModified(a))),
        events: events
          .filter((e) => e.data.seasonId?.id === season.id)
          .sort((a, b) => Date.parse(a.data.startsAt) - Date.parse(b.data.startsAt)),
      },
    };
  });
}

const { season, game, prev, next, posts, events, phase, stage, indexable } = Astro.props;
const s = season.data;
const term = game.data.seasonTerm;
const start = Date.parse(s.startsAt);
// 종료일이 없으면 다음 시즌 시작을 진행률의 끝으로 쓴다 (게임 페이지와 같은 기준)
const progressEnd = s.endsAt ?? next?.data.startsAt;
// 진행 상태는 시각으로 판정 (getStaticPaths에서 계산, 매일 자동 재빌드로 갱신)
const upcoming = phase === 'upcoming';
const over = phase === 'ended';
const state = stageLabel[stage];
const days = s.endsAt ? kstDay(Date.parse(s.endsAt)) - kstDay(start) : undefined;
const startText = formatKst(s.startsAt, s.timePrecision, true);

const milestones = seasonMilestones(season, prev, events);
// 공유 미리보기: 대표 이미지가 있으면 1200px로
const heroImg = s.images?.[0] ? seasonImage(s.images[0].file) : undefined;
const ogImage = heroImg ? (await getImage({ src: heroImg, width: Math.min(1200, heroImg.width), format: 'jpg' })).src : undefined;

// 직전 시즌과 비교: 종료일이 없으면 이번 시즌 시작까지를 기간으로 본다
const prevDays = prev
  ? kstDay(Date.parse(prev.data.endsAt ?? s.startsAt)) - kstDay(Date.parse(prev.data.startsAt))
  : undefined;
const gapDays = prev?.data.endsAt ? kstDay(start) - kstDay(Date.parse(prev.data.endsAt)) : undefined;
// 검색어 역할 분리: "시작일" 같은 대표 검색어는 연결된 게시글이 맡고, 시즌 상세는 "일정" 정리 페이지로
const mainPost = posts[0];
const endIso = s.endsAt ?? next?.data.startsAt;
const description = `${game.data.name} ${s.name}${s.nameEn ? `(${s.nameEn})` : ''} 한국 시간 ${startText} 시작. ${term} 일정, 주요 일정, 공식 출처.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${game.data.name} ${s.name}${s.nameEn ? ` (${s.nameEn})` : ''}`,
  description,
  startDate: kstIso(s.startsAt, s.timePrecision),
  ...(endIso ? { endDate: kstIso(endIso, s.endsAt ? 'exact' : (next?.data.timePrecision ?? 'exact')) } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  location: { '@type': 'VirtualLocation', url: game.data.officialUrl ?? new URL(Astro.url.pathname, Astro.site).href },
  ...(ogImage ? { image: [new URL(ogImage, Astro.site).href] } : {}),
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base
  title={`${game.data.shortName} ${s.name} ${term === '리그' ? '리그(시즌) ' : ''}일정 · ${game.data.name}`}
  description={description}
  noindex={!indexable}
  image={ogImage}
  jsonLd={jsonLd}
>
  <section class="hero gc" style={`--game-raw:${game.data.themeColor}`}>
    <div>
      <p class="eyebrow"><a class="tag" href={`/games/${game.id}/`}>{game.data.shortName}</a></p>
      <div class="game-title"><GameStamp game={game} size="md" /><h1><SeasonName season={season} /></h1></div>
      <p>
        한국 시간 {startText} 시작
        {s.timePrecision === 'day' && <span class="muted"> · 시각 발표 전</span>}
        <span class="muted"> · {state} · {certaintyLabel[s.status]}</span>
      </p>
      {upcoming && <Countdown at={s.startsAt} precision={s.timePrecision} label={`${s.name} 시작`} />}
      {mainPost && <p class="small">자세한 정보: <a href={`/posts/${mainPost.id}/`}>{mainPost.data.title}</a></p>}
    </div>
    {upcoming && <DdayStamp at={s.startsAt} size="big" estimated={s.status === 'estimated'} />}
  </section>

  {s.images && (
    <div class="section tight"><SeasonImages season={season} mode="hero" /></div>
  )}
  {s.videos?.[0] && (
    <div class="section tight"><YouTubeEmbed video={s.videos[0]} gameId={game.id} /></div>
  )}

  {!upcoming && !over && progressEnd && (
    <section class="section tight gc" style={`--game-raw:${game.data.themeColor}`}>
      <SeasonProgress start={s.startsAt} end={progressEnd} />
      <p class="small muted flush"><span data-elapsed={s.startsAt}></span></p>
    </section>
  )}

  <section class="section" aria-labelledby="sched-title">
    <h2 class="section-title" id="sched-title">일정</h2>
    <dl class="facts">
      <dt>시작</dt><dd>{startText}</dd>
      <dt>종료</dt><dd>{s.endsAt ? formatKst(s.endsAt, 'exact', true) : over ? '공식 발표 없음' : '미정'}</dd>
      {days !== undefined && <><dt>기간</dt><dd>{days}일</dd></>}
      <dt>상태</dt><dd>{state} · {certaintyLabel[s.status]}</dd>
    </dl>
  </section>

  {milestones.length > 1 && (
    <section class="section gc" style={`--game-raw:${game.data.themeColor}`} aria-labelledby="ms-title">
      <h2 class="section-title" id="ms-title">주요 일정</h2>
      <MilestoneTimeline milestones={milestones} />
    </section>
  )}

  {prev && (
    <section class="section" aria-labelledby="cmp-title">
      <h2 class="section-title" id="cmp-title">직전 {josa(term, '과', '와')} 비교</h2>
      <dl class="facts">
        <dt>직전 {term}</dt><dd><a href={seasonPath(prev)}>{prev.data.name}</a>{prev.data.nameEn && <span class="muted"> · {prev.data.nameEn}</span>}</dd>
        <dt>직전 {term} 시작</dt><dd>{formatKst(prev.data.startsAt, prev.data.timePrecision, true)}</dd>
        <dt>직전 {term} 기간</dt><dd>{prevDays}일{!prev.data.endsAt && <span class="muted"> (종료일 미발표, 이번 {term} 시작까지)</span>}</dd>
        {gapDays !== undefined && <><dt>{term} 공백</dt><dd>{gapDays > 0 ? `${gapDays}일 (직전 ${term} 종료 ~ 이번 ${term} 시작)` : '없음'}</dd></>}
      </dl>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section" aria-labelledby="post-title">
      <h2 class="section-title" id="post-title">사전 정보</h2>
      <ul class="plain-list">
        {posts.map((p) => (
          <li class="post-item"><PostThumb post={p} game={game} /><div><span class="date">{formatKst(postModified(p), 'day')} 갱신</span><a href={`/posts/${p.id}/`}>{p.data.title}</a></div></li>
        ))}
      </ul>
    </section>
  )}

  {s.images && s.images.length > 1 && (
    <section class="section" aria-labelledby="img-title">
      <h2 class="section-title" id="img-title">공식 이미지</h2>
      <SeasonImages season={season} mode="gallery" />
    </section>
  )}

  <section class="section" aria-labelledby="src-title">
    <h2 class="section-title" id="src-title">출처</h2>
    <p class="flush"><a href={s.sourceUrl} rel="noopener">{new URL(s.sourceUrl).hostname} 공식 공지</a></p>
  </section>

  <nav class="season-nav section" aria-label={`${term} 이동`}>
    {prev ? <a href={seasonPath(prev)}>← 이전 {term}: {prev.data.name}</a> : <span></span>}
    {next ? <a href={seasonPath(next)}>다음 {term}: {next.data.name} →</a> : <span class="muted">다음 {term} 미발표</span>}
  </nav>
</Base>
