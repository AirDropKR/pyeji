---
import Base from '../../layouts/Base.astro';
import { josa } from '../../lib/korean';
import { postModified } from '../../lib/posts';
import { getCollection } from 'astro:content';
import { timelineFor, sortByStart, seasonPath, phaseOf, phaseLabel, certaintyLabel } from '../../lib/seasons';
import DdayStamp from '../../components/DdayStamp.astro';
import SeasonProgress from '../../components/SeasonProgress.astro';
import SeasonName from '../../components/SeasonName.astro';
import GameStamp from '../../components/GameStamp.astro';
import PostThumb from '../../components/PostThumb.astro';
import SeasonImages from '../../components/SeasonImages.astro';
import { formatKst, buildNow } from '../../lib/time';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((g) => ({ params: { id: g.id }, props: { game: g } }));
}
const { game } = Astro.props;
const now = buildNow();
const seasons = await getCollection('seasons');
const mine = sortByStart(seasons.filter((s) => s.data.gameId.id === game.id)).reverse();
const { current, next, currentEndsAt } = timelineFor(game.id, seasons, now);
const posts = (await getCollection('posts', (p) => p.data.gameId.id === game.id)).sort(
  (a, b) => Date.parse(postModified(b)) - Date.parse(postModified(a)),
);
const patches = (await getCollection('patches', (p) => p.data.gameId.id === game.id)).sort(
  (a, b) => Date.parse(b.data.releasedAt) - Date.parse(a.data.releasedAt),
);
// 대표 이미지: 다음 시즌 공식 이미지가 있으면 그것, 없으면 진행 중인 시즌
const featured = [next, current].find((x) => x?.data.images?.length);
const term = game.data.seasonTerm;
---
<Base title={`${game.data.shortName} 다음 ${term === '리그' ? '리그(시즌)' : term} 언제? ${game.data.name} ${term} 일정`} description={`${game.data.name}(${game.data.shortName}) 현재 ${josa(term, '과', '와')} 다음 ${term} 시작일을 한국 시간으로 정리. ${term} 기록, 사전 정보, 공식 출처.`}>
  <section class="hero gc" style={`--game-raw:${game.data.themeColor}`}>
    <div>
      <div class="game-title"><GameStamp game={game} size="md" /><h1>{game.data.name}</h1></div>
      <p>
        {next ? <>다음 {term} {next.data.name}, 한국 시간 {formatKst(next.data.startsAt, next.data.timePrecision)}{next.data.status === 'estimated' ? ' 예상' : ' 시작'}</> : <>다음 {term} 미발표</>}
      </p>
      {game.data.officialUrl && <p class="small"><a href={game.data.officialUrl} rel="noopener">공식 사이트</a></p>}
    </div>
    {next && (
      <DdayStamp at={next.data.startsAt} size="big" estimated={next.data.status === 'estimated'} />
    )}
  </section>

  {featured && (
    <div class="section tight"><SeasonImages season={featured} mode="hero" withName /></div>
  )}

  {current && (
    <section class="section tight gc" style={`--game-raw:${game.data.themeColor}`}>
      <h2 class="section-title">진행 중인 {term}</h2>
      <strong><a class="season-link" href={seasonPath(current)}><SeasonName season={current} /></a></strong>
      {currentEndsAt && <SeasonProgress start={current.data.startsAt} end={currentEndsAt} />}
      <p class="small muted flush">
        <span data-elapsed={current.data.startsAt}></span>
        {current.data.endsAt && `, ${formatKst(current.data.endsAt, 'exact')} 종료`}
      </p>
    </section>
  )}

  <section class="section">
    <h2 class="section-title">사전 정보</h2>
    {posts.length ? (
      <ul class="plain-list">
        {posts.map((p) => (
          <li class="post-item"><PostThumb post={p} game={game} /><div><span class="date">{formatKst(postModified(p), 'day')} 갱신</span><a href={`/posts/${p.id}/`}>{p.data.title}</a></div></li>
        ))}
      </ul>
    ) : <p class="muted">아직 정리한 사전 정보 없음</p>}
  </section>

  <section class="section">
    <h2 class="section-title">{term} 기록</h2>
    {mine.length ? (
      <div class="tbl">
        <table>
          <thead><tr><th>{term}</th><th>시작</th><th>종료</th><th>상태</th></tr></thead>
          <tbody>
            {mine.map((s) => (
              <tr>
                <td><a class="season-link" href={seasonPath(s)}><SeasonName season={s} /></a></td>
                <td>{formatKst(s.data.startsAt, s.data.timePrecision, true)}</td>
                <td>{s.data.endsAt ? formatKst(s.data.endsAt, 'exact', true) : phaseOf(s, seasons, now) === 'ended' ? '-' : '미정'}</td>
                <td><a href={s.data.sourceUrl} rel="noopener">{phaseLabel[phaseOf(s, seasons, now)]}{s.data.status === 'estimated' && ` · ${certaintyLabel.estimated}`}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p class="muted">아직 정리한 {term} 기록 없음</p>}
  </section>

  {patches.length > 0 && (
    <section class="section">
      <h2 class="section-title">패치 목록</h2>
      <ul class="plain-list">
        {patches.map((p) => (
          <li><span class="date">{formatKst(p.data.releasedAt, 'day')}</span><a href={p.data.sourceUrl} rel="noopener">{p.data.version} 공식 패치노트</a>{p.data.note && <span class="muted">, {p.data.note}</span>}</li>
        ))}
      </ul>
    </section>
  )}
</Base>
