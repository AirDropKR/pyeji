---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import DdayStamp from '../../components/DdayStamp.astro';
import PostCover from '../../components/PostCover.astro';
import { formatKst } from '../../lib/time';
import { seasonPath } from '../../lib/seasons';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const game = await getEntry(post.data.gameId);
const season = post.data.seasonId ? await getEntry(post.data.seasonId) : undefined;
const now = Date.now();
const upcoming = season && Date.parse(season.data.startsAt) > now;
// 공유 미리보기용: 공식 대표 이미지가 있으면 1200px로 줄여서 쓴다
const ogImage = post.data.cover
  ? (await getImage({ src: post.data.cover.src, width: 1200, format: 'jpg' })).src
  : undefined;
---
<Base title={post.data.title} type="article" image={ogImage} description={`${game.data.name} ${season?.data.name ?? ''} 시작일과 공개된 정보를 한국 시간으로 정리.`}>
  <article class="gc" style={`--game-raw:${game.data.themeColor}`}>
    <header class="hero">
      <div>
        <p class="eyebrow"><a class="tag" href={`/games/${game.id}/`}>{game.data.shortName}</a></p>
        <h1>{post.data.title}</h1>
        <p class="small muted">{formatKst(post.data.publishedAt, 'day')} 갱신{season && <> · <a href={seasonPath(season)}>{season.data.name} 일정</a></>}</p>
      </div>
      {season && upcoming && (
        <DdayStamp at={season.data.startsAt} size="big" estimated={season.data.status === 'estimated'} />
      )}
    </header>
    <div class="section tight">
      <PostCover post={post} game={game} season={season} />
    </div>
    <div class="prose section tight">
      <Content />
      <h2>출처</h2>
      <ul>
        {post.data.sourceUrls.map((u) => <li><a href={u} rel="noopener">{new URL(u).hostname}</a></li>)}
      </ul>
    </div>
  </article>
</Base>
