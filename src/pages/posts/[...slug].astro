---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import DdayStamp from '../../components/DdayStamp.astro';
import PostCover from '../../components/PostCover.astro';
import { formatKst, buildNow } from '../../lib/time';
import { postModified, COMMON_TAG } from '../../lib/posts';
import { ogPath } from '../../lib/og-paths';
import { monthRange, nextMonth, pickNext, type MonthItem } from '../../lib/month';
import { seasonPath, neighbors, seasonMilestones } from '../../lib/seasons';
import MilestoneTimeline from '../../components/MilestoneTimeline.astro';
import Countdown from '../../components/Countdown.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import SeasonCycleTable from '../../components/SeasonCycleTable.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const game = post.data.gameId ? await getEntry(post.data.gameId) : undefined;
const tagColor = game?.data.themeColor ?? COMMON_TAG.color;
const season = post.data.seasonId ? await getEntry(post.data.seasonId) : undefined;
const now = buildNow();
const countdown = post.data.countdownTo ? await getEntry(post.data.countdownTo) : undefined;
// D-day 대상: 지정한 일정이 있으면 그것, 없으면 연결된 시즌 시작
// 월간 일정 글: 그 달 안의 시즌 시작·종료와 이벤트 중 지금 기준 가장 가까운 다음 일정 (브라우저에서도 다시 고름)
let monthItems: MonthItem[] = [];
let nextMonthPost: (typeof post) | undefined;
if (post.data.month) {
  const [from, to] = monthRange(post.data.month);
  const inMonth = (iso: string) => Date.parse(iso) >= from && Date.parse(iso) < to;
  const allSeasons = await getCollection('seasons');
  const allEvents = await getCollection('events');
  const items: MonthItem[] = [
    ...allSeasons.filter((s) => inMonth(s.data.startsAt)).map((s) => ({ at: s.data.startsAt, label: `${s.data.name} 시작`, precision: s.data.timePrecision })),
    ...allSeasons.filter((s) => s.data.endsAt && inMonth(s.data.endsAt)).map((s) => ({ at: s.data.endsAt!, label: `${s.data.name} 종료`, precision: 'exact' as const })),
    ...allEvents.filter((e) => inMonth(e.data.startsAt)).map((e) => ({ at: e.data.startsAt, label: e.data.title, precision: e.data.timePrecision })),
  ].sort((a, b) => Date.parse(a.at) - Date.parse(b.at));
  // 같은 시각의 같은 일정(시즌 종료와 종료 이벤트 등)은 하나로
  monthItems = items.filter((it, i) => i === 0 || it.at !== items[i - 1].at);
  nextMonthPost = (await getCollection('posts')).find((p) => p.data.month === nextMonth(post.data.month!));
}
const monthNext = post.data.month ? pickNext(monthItems, now) : undefined;
const target = post.data.month
  ? monthNext && { ...monthNext, estimated: false }
  : countdown
  ? { at: countdown.data.startsAt, precision: countdown.data.timePrecision, estimated: false, label: countdown.data.title }
  : season
    ? { at: season.data.startsAt, precision: season.data.timePrecision, estimated: season.data.status === 'estimated', label: `${season.data.name} 시작` }
    : undefined;
// 연결된 시즌의 주요 일정 (시즌 상세 페이지와 같은 내용)
const milestones = season
  ? seasonMilestones(season, neighbors(season, await getCollection('seasons')).prev, await getCollection('events'))
  : [];
const upcoming = target && Date.parse(target.at) > now;
// 공유 미리보기: 빌드 때 만든 글 이미지. 구조화 데이터의 image는 공식 대표 이미지가 있으면 그것
const coverImg = post.data.cover
  ? (await getImage({ src: post.data.cover.src, width: Math.min(1200, post.data.cover.src.width), format: 'jpg' })).src
  : undefined;
const ogImage = ogPath('post', post.id);
const modified = postModified(post);
const description = post.data.description ?? `${game?.data.name ?? COMMON_TAG.name} ${season?.data.name ?? ''} 시작일과 공개된 정보를 한국 시간으로 정리.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description,
  datePublished: post.data.publishedAt,
  dateModified: modified,
  inLanguage: 'ko-KR',
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  image: [new URL(coverImg ?? ogImage, Astro.site).href],
  author: { '@type': 'Organization', name: '폐지.com', url: 'https://pyeji.kr/' },
  publisher: { '@type': 'Organization', name: '폐지.com', url: 'https://pyeji.kr/' },
};
---
<Base title={post.data.title} type="article" image={ogImage} description={description} jsonLd={jsonLd}>
  <article class="gc" style={`--game-raw:${tagColor}`}>
    <header class="hero" data-month-candidates={post.data.month ? JSON.stringify(monthItems) : undefined}>
      <div>
        <p class="eyebrow">{game ? <a class="tag" href={`/games/${game.id}/`}>{game.data.shortName}</a> : <span class="tag">{COMMON_TAG.label}</span>}</p>
        <h1>{post.data.title}</h1>
        <p class="small muted"><time datetime={modified}>{formatKst(modified, 'day')}</time> 갱신{season && <> · <a href={seasonPath(season)}>{season.data.name} 일정</a></>}</p>
        {target && upcoming && <Countdown at={target.at} precision={target.precision} label={target.label} />}
        {post.data.month && nextMonthPost && (
          <p class="small month-next" hidden={Boolean(target && upcoming)}>이달 일정 끝 · <a href={`/posts/${nextMonthPost.id}/`}>{nextMonthPost.data.title}</a></p>
        )}
      </div>
      {target && upcoming && <DdayStamp at={target.at} size="big" estimated={target.estimated} />}
    </header>
    <div class="section tight">
      <PostCover post={post} game={game} season={season} />
    </div>
    {milestones.length > 1 && (
      <section class="section tight" aria-labelledby="ms-title">
        <h2 class="section-title" id="ms-title">주요 일정</h2>
        <MilestoneTimeline milestones={milestones} />
      </section>
    )}
    {post.data.reveal && (
      <section class="section tight reveal" aria-labelledby="reveal-title">
        <h2 class="section-title" id="reveal-title">{post.data.reveal.heading}</h2>
        {post.data.reveal.revealedAt && <p class="small muted flush">한국 시간 {formatKst(post.data.reveal.revealedAt, 'exact')} 발표</p>}
        <ul>{post.data.reveal.items.map((i) => <li>{i}</li>)}</ul>
        <p class="small">출처: {post.data.reveal.sourceUrls.map((u, i) => <>{i > 0 && ' · '}<a href={u} rel="noopener">{new URL(u).hostname}</a></>)}</p>
      </section>
    )}
    {post.data.videos?.[0] && (
      <div class="section tight"><YouTubeEmbed video={post.data.videos[0]} gameId={game?.id} /></div>
    )}
    <div class="prose section tight">
      <Content />
      {post.data.cycleTable && <SeasonCycleTable game={await getEntry(post.data.cycleTable)} seasons={await getCollection('seasons')} />}
      <h2>출처</h2>
      <ul>
        {post.data.sourceUrls.map((u) => <li><a href={u} rel="noopener">{new URL(u).hostname}</a></li>)}
      </ul>
    </div>
  </article>
</Base>
