---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import DdayStamp from '../../components/DdayStamp.astro';
import PostCover from '../../components/PostCover.astro';
import { formatKst, buildNow } from '../../lib/time';
import { seasonPath, neighbors, seasonMilestones } from '../../lib/seasons';
import MilestoneTimeline from '../../components/MilestoneTimeline.astro';
import Countdown from '../../components/Countdown.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const game = await getEntry(post.data.gameId);
const season = post.data.seasonId ? await getEntry(post.data.seasonId) : undefined;
const now = buildNow();
const countdown = post.data.countdownTo ? await getEntry(post.data.countdownTo) : undefined;
// D-day 대상: 지정한 일정이 있으면 그것, 없으면 연결된 시즌 시작
const target = countdown
  ? { at: countdown.data.startsAt, precision: countdown.data.timePrecision, estimated: false, label: countdown.data.title }
  : season
    ? { at: season.data.startsAt, precision: season.data.timePrecision, estimated: season.data.status === 'estimated', label: `${season.data.name} 시작` }
    : undefined;
// 연결된 시즌의 주요 일정 (시즌 상세 페이지와 같은 내용)
const milestones = season
  ? seasonMilestones(season, neighbors(season, await getCollection('seasons')).prev, await getCollection('events'))
  : [];
const upcoming = target && Date.parse(target.at) > now;
// 공유 미리보기용: 공식 대표 이미지가 있으면 1200px로 줄여서 쓴다
const ogImage = post.data.cover
  ? (await getImage({ src: post.data.cover.src, width: Math.min(1200, post.data.cover.src.width), format: 'jpg' })).src
  : undefined;
---
<Base title={post.data.title} type="article" image={ogImage} description={`${game.data.name} ${season?.data.name ?? ''} 시작일과 공개된 정보를 한국 시간으로 정리.`}>
  <article class="gc" style={`--game-raw:${game.data.themeColor}`}>
    <header class="hero">
      <div>
        <p class="eyebrow"><a class="tag" href={`/games/${game.id}/`}>{game.data.shortName}</a></p>
        <h1>{post.data.title}</h1>
        <p class="small muted">{formatKst(post.data.publishedAt, 'day')} 갱신{season && <> · <a href={seasonPath(season)}>{season.data.name} 일정</a></>}</p>
        {target && upcoming && <Countdown at={target.at} precision={target.precision} label={target.label} />}
      </div>
      {target && upcoming && <DdayStamp at={target.at} size="big" estimated={target.estimated} />}
    </header>
    <div class="section tight">
      <PostCover post={post} game={game} season={season} />
    </div>
    {milestones.length > 1 && (
      <section class="section tight" aria-labelledby="ms-title">
        <h2 class="section-title" id="ms-title">주요 일정</h2>
        <MilestoneTimeline milestones={milestones} />
      </section>
    )}
    <div class="prose section tight">
      <Content />
      <h2>출처</h2>
      <ul>
        {post.data.sourceUrls.map((u) => <li><a href={u} rel="noopener">{new URL(u).hostname}</a></li>)}
      </ul>
    </div>
  </article>
</Base>
