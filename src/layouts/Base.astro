---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { ogPath } from '../lib/og-paths';
import InstallButton from '../components/InstallButton.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 공유 미리보기 이미지 경로 (사이트 기준 상대 경로 가능) */
  image?: string;
  /** 구조화 데이터 (schema.org JSON-LD) */
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = 'POE1, POE2, 디아블로 2·4, 토치라이트, 라스트 에폭의 리그·시즌 시작일과 사전 공개 정보를 한국 시간으로 정리.',
  type = 'website',
  noindex = false,
  image,
  jsonLd,
} = Astro.props;
// 공유 미리보기: 페이지가 따로 주지 않으면 사이트 기본 이미지
const ogImage = new URL(image ?? ogPath('default'), Astro.site).href;
const fullTitle = title ? `${title} | 폐지.com` : '폐지.com | 핵앤슬래시 리그·시즌 일정, 한국 시간';
const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="폐지.com" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#c9af86" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1915" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="폐지" />
    <link rel="alternate" type="application/rss+xml" title="폐지.com 사전 정보" href="/rss.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="naver-site-verification" content="2f92d9be6d39d28b1cbc4134a02e68acc8bc0153" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=IBM+Plex+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- 구글 애드센스 사이트 연결. 광고 단위는 승인 후 별도로 넣는다 -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6396817598665368" crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="logo" href="/" aria-label="폐지.com 처음으로">폐지.com</a>
        <nav class="site-nav" aria-label="사이트">
          <a href="/calendar/" aria-current={path.startsWith('/calendar') ? 'page' : undefined}>폐지달력</a>
          <a href="/posts/" aria-current={path === '/posts/' ? 'page' : undefined}>전체 글</a>
          {games.map((g) => (
            <a href={`/games/${g.id}/`} aria-current={path.startsWith(`/games/${g.id}`) ? 'page' : undefined}>{g.data.shortName}</a>
          ))}
        </nav>
      </header>
      <main class="sheet">
        <slot />
      </main>
      <footer class="site-footer">
        <p>비공식 팬 사이트. 공식 발표 기준, 모든 시간은 한국 시간(KST).</p>
        <nav class="footer-nav" aria-label="사이트 정보">
          <a href="/about/">소개</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/contact/">문의·정정 요청</a>
        </nav>
      </footer>
    </div>
    <InstallButton />
    <script>import '../scripts/live.ts';</script>
  </body>
</html>
