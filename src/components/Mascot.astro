---
// 주섬이. 파일이 없으면 아무것도 그리지 않는다 (원본을 넣으면 자동으로 나타남)
import { Image } from 'astro:assets';
import { mascotFor, MASCOT_WIDTHS, type MascotForm } from '../lib/mascot';

interface Props {
  gameId?: string;
  form?: MascotForm;
  pose?: string;
  /** 화면 표시 폭(px) */
  size?: number;
  class?: string;
}
const { gameId, form = 'full', pose, size = form === 'icon' ? 48 : 256, class: cls } = Astro.props;
const img = mascotFor(gameId, form, pose);
---
{img && (
  <Image
    src={img}
    alt="폐지.com 마스코트 주섬이"
    widths={MASCOT_WIDTHS[form].filter((w) => w <= img.width)}
    sizes={`${size}px`}
    format="webp"
    class:list={['mascot', form, cls]}
    style={`--mascot-size:${size}px`}
  />
)}
