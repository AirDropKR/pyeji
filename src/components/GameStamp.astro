---
// 게임 도장: 게임 색 원형 이중 테두리 안에 약어(POE1, D4 등). 공식 로고 대신 직접 만든 표식
import type { CollectionEntry } from 'astro:content';

interface Props {
  game?: CollectionEntry<'games'>;
  /** 게임 없이 쓸 때 (공통 글) */
  code?: string;
  color?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { game, size = 'md' } = Astro.props;
const code = game ? game.id.toUpperCase() : (Astro.props.code ?? '');
const color = game ? game.data.themeColor : (Astro.props.color ?? '#6A6056');
---
<span class:list={['game-stamp gc', size, { long: code.length > 3 }]} style={`--game-raw:${color}`} aria-hidden="true">{code}</span>
