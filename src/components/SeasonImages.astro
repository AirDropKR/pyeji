---
// 시즌 공식 이미지. mode="hero": 대표 한 장, mode="gallery": 나머지 갤러리
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { seasonImage } from '../lib/images';

interface Props {
  season: CollectionEntry<'seasons'>;
  mode: 'hero' | 'gallery';
  /** hero 캡션 앞에 시즌 이름을 붙일지 (게임 페이지처럼 다른 맥락에서 쓸 때) */
  withName?: boolean;
}
const { season, mode, withName = false } = Astro.props;
const images = season.data.images ?? [];
const hero = images[0];
const rest = images.slice(1);
---
{mode === 'hero' && hero && (
  <figure class="post-cover">
    <Image src={seasonImage(hero.file)} alt={hero.alt} widths={[640, 960, 1600]} sizes="(max-width: 1040px) 100vw, 960px" loading="eager" />
    <figcaption class="small muted">
      {withName ? `${season.data.name} · ` : ''}{hero.caption} · 이미지: <a href={hero.creditUrl} rel="noopener">{hero.credit}</a>
    </figcaption>
  </figure>
)}
{mode === 'gallery' && rest.length > 0 && (
  <ul class="gallery">
    {rest.map((img) => {
      const src = seasonImage(img.file);
      return (
        <li>
          <figure>
            <a href={src.src} target="_blank" rel="noopener">
              <Image src={src} alt={img.alt} widths={[480, 800]} sizes="(max-width: 640px) 100vw, 460px" />
            </a>
            <figcaption class="small">{img.caption}<span class="muted"> · 이미지: <a href={img.creditUrl} rel="noopener">{img.credit}</a></span></figcaption>
          </figure>
        </li>
      );
    })}
  </ul>
)}
