---
// 글 목록 썸네일: 공식 대표 이미지가 있으면 축소본, 없으면 게임 도장
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import GameStamp from './GameStamp.astro';
import { COMMON_TAG } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  game?: CollectionEntry<'games'>;
}
const { post, game } = Astro.props;
const cover = post.data.cover;
---
<span class="post-thumb" aria-hidden="true">
  {cover ? <Image src={cover.src} alt="" width={192} /> : (game ? <GameStamp game={game} size="sm" /> : <GameStamp code={COMMON_TAG.code} color={COMMON_TAG.color} size="sm" />)}
</span>
